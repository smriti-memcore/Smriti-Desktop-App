{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smriti",
  "version": "1.0.0",
  "identifier": "com.smriti.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SMRITI Memory Palace",
        "width": 1000,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "quick-search",
        "title": "SMRITI Quick Search",
        "width": 600,
        "height": 450,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "sidecars/smriti-daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
